{
  "name": "running-coach-mcp",
  "version": "0.1.0",
  "description": "An MCP server that lets Claude (or any MCP client) answer questions about your running data from your actual numbers.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --import tsx --test src/data/__tests__/*.test.ts src/analysis/__tests__/*.test.ts src/server/__tests__/*.test.ts src/evals/__tests__/*.test.ts",
    "test:evals-groundtruth": "node --import tsx --test src/evals/__tests__/questions.groundtruth.test.ts",
    "start": "tsx src/server/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/server/index.ts",
    "eval": "tsx src/evals/runEvals.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  }
}
